msgid "15 min"
msgstr "15 min"

#: main.lua:906
msgid "30 min"
msgstr "30 min"

#: main.lua:916
msgid "45 min"
msgstr "45 min"

#: main.lua:926
msgid "60 min"
msgstr "60 min"

